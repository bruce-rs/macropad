#include <dt-bindings/zmk/matrix_transform.h>

#include "macropad2-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    // Direct wiring: each key goes from its own pin to GND, no diodes needed.
    kscan: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // key 1: pin labeled 017 (P0.17)
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // key 2: pin labeled 020 (P0.20)
            ;
    };

    // Direct wiring reports every key as row 0, column N.
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <1>;
        map = <
            RC(0, 0) RC(0, 1)
        >;
    };
};
